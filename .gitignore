# 白名单：只有程序和说明文档进仓库；期/、基础/、收件箱/、代码仓库.json、索引、缓存、日志、虚拟环境一律不进
/*
!/.gitignore
!/README.md
!/kb
!/install.sh
!/使用说明.md
!/DOCKER.md
!/docker-compose.yml
!/docker.env.example
!/介绍.png
!/docs/
!/插件/
!/_system/
/_system/*
!/_system/kb.py
!/_system/kblib/
!/_system/web.py
!/_system/webapp/
!/_system/web.html
!/_system/ui-templates.js
!/_system/ui-preview.html
!/_system/ui/
!/_system/requirements.txt
!/_system/requirements-db.txt
!/_system/团队默认.json
!/_system/bin/
!/_system/Dockerfile
!/_system/Dockerfile.dockerignore
!/_system/Dockerfile.runner
!/_system/Dockerfile.runner.dockerignore
!/_system/docker-entrypoint.sh
!/_system/tests/
!/tools/
/tools/*
!/tools/make-public.py
!/tools/check-arch.py
__pycache__/

# Docker 部署：本地密码（.env）不进仓库
.env
