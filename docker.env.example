# 复制成 .env（已在 .gitignore 里，别提交）后按需修改；docker compose 会自动读取。
# 管理员初始密码（至少 8 位，默认 admin123）：只在第一次启动、库里还没有账号时用来建 admin，首次登录会要求改掉
# KB_ADMIN_PASSWORD=admin123
# 元数据库密码（compose 自带的 PostgreSQL 用；数据库端口不对外发布）
KB_DB_PASSWORD=
# 元数据库：默认 compose 里的 PostgreSQL；换 MySQL 填 mysql://kb:<KB_DB_PASSWORD>@mysql:3306/kb 并 docker compose --profile mysql up -d；
# 用卷里的 SQLite 填 sqlite；连已有数据库直接填它的连接串
# KB_DB_URL=
# KB_ADMIN_USER=admin
# 网页发布到哪：默认只给本机；局域网同事要用改成 0.0.0.0:11555（建议前面加 HTTPS 反向代理）
# KB_PUBLISH=127.0.0.1:11555
# 1 = 控制面容器里不跑 AI 会话，全交给执行机（默认 0：没有执行机在线时控制面自己兜底）
# KB_NO_LOCAL_RUNNER=0
# 0 = 镜像里不装 Claude Code / Codex 命令行（只演练 / 只跑网页时更小更快）
# KB_WITH_ENGINES=1
# 主密钥文件（机密加密用）：正式部署建议用 docker secret 挂进来再指过去
# KB_MASTER_KEY_FILE=/run/secrets/kb_master_key
# 国内网络拉不到 Docker Hub / Debian / npm / PyPI 时（构建报 failed to resolve source metadata）：
# KB_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# KB_PG_IMAGE=docker.m.daocloud.io/library/postgres:16
# KB_MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4
# KB_NODE_IMAGE=docker.m.daocloud.io/library/node:22-slim
# KB_APT_MIRROR=mirrors.aliyun.com
# KB_NPM_REGISTRY=https://registry.npmmirror.com
# KB_PIP_INDEX=https://mirrors.aliyun.com/pypi/simple
