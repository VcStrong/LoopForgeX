# 执行机容器模板（REQ-032 拓扑 B / docker-compose.yml 的 runner 服务）：Linux 执行机，只出站连接控制面，不暴露端口。
#   docker build -f _system/Dockerfile.runner -t kb-runner .        （在仓库根目录；一般直接 docker compose up -d）
#   docker run -d --add-host host.docker.internal:host-gateway -v kb-runner-1:/data kb-runner \
#       runner --server http://host.docker.internal:<端口> --token <注册令牌> --name docker-1
#   也可用环境变量：KB_SERVER、KB_RUNNER_TOKEN（只第一次注册用）、KB_RUNNER_NAME。
# 数据目录 /data（KB_ROOT、会话私有 HOME、工作副本池、runner.json 都在里面），挂卷保留，重建容器不用重新注册。
# 构建参数 WITH_ENGINES=1：装 Node + Claude Code / Codex 命令行（真跑 AI 会话要用；登录态由控制面「AI 账号」按会话下发）。
# 安卓编译要 Android SDK / JDK：在此基础上自己加一层；插 USB 的手机在 Mac 上没法直通容器，留给 Mac 本机 kb runner。
ARG BASE_IMAGE=python:3.12-slim
ARG NODE_IMAGE=node:22-slim
FROM ${NODE_IMAGE} AS node
FROM ${BASE_IMAGE}
ARG WITH_ENGINES=1
# 国内网络：APT_MIRROR=mirrors.aliyun.com、NPM_REGISTRY=https://registry.npmmirror.com、PIP_INDEX=https://mirrors.aliyun.com/pypi/simple
ARG APT_MIRROR=
ARG NPM_REGISTRY=
ARG PIP_INDEX=
RUN if [ -n "$APT_MIRROR" ]; then sed -i "s#deb.debian.org#$APT_MIRROR#g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; fi \
    && apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends git openssh-client openssl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*
# Node 从官方 node 镜像拷（比 apt 装 npm 少几百个包）；引擎命令行按需装
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && if [ "$WITH_ENGINES" = "1" ]; then npm install -g ${NPM_REGISTRY:+--registry $NPM_REGISTRY} @anthropic-ai/claude-code @openai/codex \
       && npm cache clean --force; fi
WORKDIR /kb
COPY _system/requirements.txt /kb/_system/requirements.txt
RUN pip install --no-cache-dir ${PIP_INDEX:+-i $PIP_INDEX} -r /kb/_system/requirements.txt
COPY kb /kb/kb
COPY _system /kb/_system
RUN chmod +x /kb/_system/docker-entrypoint.sh && printf '#!/bin/sh\nexec python /kb/_system/kb.py "$@"\n' > /usr/local/bin/kb && chmod +x /usr/local/bin/kb
ENV KB_RUNNER_DATA=/data KB_SECRET_BACKEND=file PYTHONUNBUFFERED=1 TZ=Asia/Shanghai
VOLUME /data
ENTRYPOINT ["tini", "--", "/kb/_system/docker-entrypoint.sh"]
CMD ["runner"]
